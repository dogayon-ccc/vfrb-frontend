# Copy to .env.local and restart Vite. Without VITE_MODEL_BASE_URL every GLB 404s and the landing hero and Studio 3D fall back to 2D.
VITE_MODEL_BASE_URL=https://res.cloudinary.com/jh4fru9j/raw/upload/models-draco
# Production API base URL (leave unset in dev; Vite proxies /api to VITE_PROXY_TARGET)
VITE_API_URL=
VITE_PROXY_TARGET=http://127.0.0.1:8000
# VITE_GOOGLE_LOGIN=false
